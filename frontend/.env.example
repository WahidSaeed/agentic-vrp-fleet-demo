# Copy to .env.local and fill from `sam deploy` outputs. Do NOT commit .env.local.
# DEMO_MODE: "live" uses the deployed WebSocket API; "replay" uses replay-data/ only.
VITE_DEMO_MODE=replay

# Only needed when VITE_DEMO_MODE=live:
VITE_WS_URL=wss://REPLACE.execute-api.eu-central-1.amazonaws.com/demo
VITE_WS_TOKEN=fleet-demo

# Replay log: replay-data/session.json is served at the web root by Vite (publicDir)
VITE_REPLAY_URL=/session.json
